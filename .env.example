# These are public game offer settings. NEXT_PUBLIC values are included in the browser bundle.
NEXT_PUBLIC_OFFERS_ENABLED=true

NEXT_PUBLIC_OFFER_5_ENABLED=true
NEXT_PUBLIC_OFFER_5_MIN_SCORE=180
NEXT_PUBLIC_OFFER_5_MAX_SCORE=219
NEXT_PUBLIC_OFFER_5_PERCENT=5
NEXT_PUBLIC_OFFER_5_CODE=

NEXT_PUBLIC_OFFER_10_ENABLED=true
NEXT_PUBLIC_OFFER_10_MIN_SCORE=220
NEXT_PUBLIC_OFFER_10_MAX_SCORE=249
NEXT_PUBLIC_OFFER_10_PERCENT=10
NEXT_PUBLIC_OFFER_10_CODE=

NEXT_PUBLIC_OFFER_FREE_ENABLED=true
NEXT_PUBLIC_OFFER_FREE_MIN_SCORE=250
NEXT_PUBLIC_OFFER_FREE_PRODUCTS=سبريد تمر|دقة زعتر
NEXT_PUBLIC_OFFER_FREE_CODE=

# ─── Google Sheets (server env — مش NEXT_PUBLIC) ───
# آيدي الشيت من الرابط + اسم التاب اللي هيستقبل الصفوف
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Leads
# Service Account من Google Cloud (فعّل Google Sheets API وشارك الشيت مع الإيميل ده Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# المفتاح الخاص كامل — لو في سطر واحد استخدم \n بين السطور
GOOGLE_PRIVATE_KEY=
